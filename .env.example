# =============================================================
#  Variáveis de ambiente — copie para .env e preencha
#  (o .env é ignorado pelo git e NUNCA vai para o GitHub)
# =============================================================

# -------- Banco de dados --------

# USO LOCAL (notebook): banco em arquivo, funciona sem internet.
DATABASE_URL="file:./dev.db"

# PRODUÇÃO (Vercel): banco no Turso.
# Deixe as duas linhas abaixo VAZIAS/comentadas no seu notebook —
# se TURSO_DATABASE_URL estiver preenchida, o sistema usa a nuvem.
# TURSO_DATABASE_URL="libsql://seu-banco-seu-usuario.turso.io"
# TURSO_AUTH_TOKEN="cole-aqui-o-token-gerado-pelo-turso"

# -------- Proteção por senha --------

# Senha única para entrar no painel.
# Se ficar VAZIA, o site abre sem pedir senha (modo local no notebook).
# Em produção é OBRIGATÓRIA — sem ela, qualquer pessoa com o link vê
# nome, telefone e situação de pagamento dos convidados.
# SENHA_ACESSO="troque-por-uma-senha-forte"

# Segredo usado para assinar o cookie de sessão.
# Gere um valor aleatório longo (ex: 40+ caracteres) e não reutilize
# de outro projeto. Trocar este valor desconecta todo mundo.
# SESSION_SECRET="cole-aqui-uma-sequencia-aleatoria-bem-longa"
